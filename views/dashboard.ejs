<%- include('partials/header.ejs'); -%>

<main class="container-xl my-5">
  <div id="editView">
    <div class="item-add-mainbox" id="item-edit-main">
      <div class="container mt-3">
        <div class="row item-add-title">
          <div class="col-5 ps-5">Item</div>
          <div class="col-3 text-center">Quantity</div>
          <div class="col text-center">Price</div>
        </div>
        <div class="row" data-id="" id="item-edit-info">
          <div class="col-5 d-flex flex-column flex-sm-row align-items-start align-items-sm-center" id="item-add-item-image">
            <img src="https://services.runescape.com/m=itemdb_oldschool/obj_sprite.gif?id=1357" alt="item image">
            <div class="m-font fw-medium py-sm-2 ps-sm-3">TEST ITEM</div>
          </div>
          <div class="col-3 d-flex justify-content-center align-items-center">
            <div class="fw-medium" id="item-edit-item-quantity">100</div>
          </div>
          <div class="col-4 d-none d-md-flex justify-content-center align-items-center">
            <div class="fw-medium" id="item-edit-item-price">$10.1K</div>
          </div>
        </div>
        <form class="row mt-4" action="/watchTable/edit">
          <div class="col input-group">
            <span class="input-group-text">Quantity</span>
            <input type="number" class="form-control" id="item-edit-qty" value="1" min="1">
          </div>
          <div class="col">
            <div class="input-group">
              <span class="input-group-text">Price</span>
              <input type="number" class="form-control" id="item-edit-price" value="1" min="1">
              <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="item-edit-dropdown-unit">gp</button>
              <ol class="dropdown-menu dropdown-menu-end" id="item-edit-dropdown-unit-list">
                <li><a class="dropdown-item">gp</a></li>
                <li><a class="dropdown-item">K</a></li>
                <li><a class="dropdown-item">M</a></li>
                <li><a class="dropdown-item">B</a></li>
              </ol>
            </div>
          </div>
          <div class="col-12 my-3 d-flex justify-content-center">
            <div>
              <input type="button" value="Update Item Info" id="item-edit-submit"></input>
            </div>
          </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="container-fluid" id="watchTable">
    <div class="row">
      <div class="col-11 col-sm-5 col-xl-2 d-none d-sm-block me-5">Your Watched Items</div>
      <div class="col-5 d-sm-none">Item</div>
      <div class="col-1 text-center d-none d-xl-block mx-3">Price (ea)</div>
      <div class="col-1 text-end d-none d-xl-block mx-3">Quantity</div>
      <div class="col col-xl-2 text-center ms-0">Day Gain</div>
      <div class="col-2 col-xl-1 text-center text-xl-end">Value</div>
      <div class="col col-xl-3 text-center d-none d-xl-block">Value Change</div>
      <div class="col-sm-1 d-none d-sm-block"></div>
    </div>
    <% userItemListArray.forEach(listItem => { %>
     <%- listItem %>
    <% }) %>
  </div>
</main>
<%- include('partials/footer.ejs'); -%>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>
<script type="module" src="./scripts/common.mjs"></script>
<script type="module" src="./scripts/dashboard.mjs"></script>
</body>

</html>