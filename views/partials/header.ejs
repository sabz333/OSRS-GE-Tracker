<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Old School Runescape GE Tracker</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="<%- mainStyleSheet %>" />
  </head>
  <body>
    <header>
      <div class="container-fluid py-3 px-1 px-sm-2" id="mainHeader">
        <div class="row">
          <div class="col-4 d-flex align-items-center">
            <span class="material-symbols-rounded d-none"> menu </span>
              <a href="/" class="ps-3">
                <img id="logo" src="/assets/logo/logo_alt.svg" alt="OSRS GE Tracker Logo">
              </a>
          </div>
          <div class="col-4"></div>
          <div class="col-4 pe-3 d-flex flex-row-reverse">    
            <a href="/dashboard" class="d-flex flex-column align-items-center" id="user">
              <span class="material-symbols-rounded" style="font-size: 36px;"> person </span>
              <span style="font-size: 18px;"><%= dashboardBoolean ? "Dashboard" : "Login" %></span>
            </a>
          </div>
        </div>
      </div>
      <div class="container-fluid px-1 px-sm-2 mb-2" id="headerCardDisplay">
        <div class="container d-flex flex-column px-1 px-sm-2">
          <form action="/mover" method="post" id="headerCategorySelection" class="d-flex align-items-center me-2 pt-2">
            <span class="pe-2">TOP MOVERS</span>
            <input type="submit" name="mover" value="10" id="potions">
            <label for="potions" class="<%= catId == 10 ? "active" : "" %>">Potions</label>
            <input type="submit" name="mover" value="5" id="herbs">
            <label for="herbs" class="<%= catId == 5 ? "active" : "" %>">Herbs</label>
            <input type="submit" name="mover" value="11" id="runes">
            <label for="runes" class="<%= catId == 11 ? "active" : "" %>">Runes</label>
            <input type="submit" name="mover" value="3" id="food">
            <label for="food" class="<%= catId == 3 ? "active" : "" %>">Food</label>
            <input type="submit" name="mover" value="6" id="jewellery">
            <label for="jewellery" class="<%= catId == 6 ? "active" : "" %>">Jewellery</label>
            <input type="submit" name="mover" value="12" id="logs">
            <label for="logs" class="<%= catId == 12 ? "active" : "" %>">Logs</label>
            <input type="submit" name="mover" value="9" id="ores">
            <label for="ores" class="<%= catId == 9 ? "active" : "" %>">Ores</label>
            <input type="submit" name="mover" value="1" id="ammo">
            <label for="ammo" class="<%= catId == 1 ? "active" : "" %>">Ammo</label>
            <input type="submit" name="mover" value="13" id="seeds">
            <label for="seeds" class="<%= catId == 13 ? "active" : "" %>">Seeds</label>
          </form>
          <div class="container p-2 d-flex" id="headerCards">
            <% headerCardArray.forEach(card => { %>
             <%- card %>
            <% }) %>
          </div>
        </div>
      </div>
      <div class="search">
        <span class="material-symbols-rounded"> search </span>
        <div class="searchBar">
          <div class="searchInput d-flex">
            <input
              type="text"
              autocomplete="off"
              placeholder="Search for items"
              id="searchBarInput"
            />
          </div>
        </div>
        <div id="searchBox">
          <div id="searchResults">
          </div>
        </div>
      </div>
      <div id="item-add">
        <div class="item-add-mainbox" id="item-add-main">
          <div class="container mt-3" style="width: 90%;">
            <div class="row item-add-title">
              <div class="col-5 ps-5">Item</div>
              <div class="col-3">Current Price</div>
              <div class="col text-center">Day Change</div>
            </div>
            <div class="row" data-id="" id="item-add-info">
              <div class="col-5 d-flex flex-column flex-sm-row align-items-start align-items-sm-center" id="item-add-item-image">
                <img src="https://services.runescape.com/m=itemdb_oldschool/obj_sprite.gif?id=1357" alt="item image">
                <div class="m-font fw-medium py-sm-2 ps-sm-3">TEST ITEM</div>
              </div>
              <div class="col-3 d-flex justify-content-center align-items-center">
                <div class="fw-medium" id="item-add-item-price">$10.1K</div>
              </div>
              <div class="col-4 d-none d-md-flex justify-content-center align-items-center">
                  <span class="fw-medium pe-2 positive" id="item-add-item-change">2.1K</span>
                  <div class="percentChangePill d-flex justify-content-end align-items-center positive" id="item-add-item-changePercent">
                    <span class="material-symbols-rounded percentChangeArrow">arrow_upward</span>
                    <span class="fw-medium">10.1%</span>
                  </div>
              </div>
            </div>
            <form class="row mt-4" action="/watchTable/add">
              <div class="col input-group">
                <span class="input-group-text">Quantity</span>
                <input type="number" class="form-control" id="item-add-qty" value="1" min="1">
              </div>
              <div class="col">
                <div class="input-group">
                  <span class="input-group-text">Price</span>
                  <input type="number" class="form-control" id="item-add-price" value="1" min="1">
                  <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="item-add-dropdown-unit">gp</button>
                  <ol class="dropdown-menu dropdown-menu-end" id="item-add-dropdown-unit-list">
                    <li><a class="dropdown-item">gp</a></li>
                    <li><a class="dropdown-item">K</a></li>
                    <li><a class="dropdown-item">M</a></li>
                    <li><a class="dropdown-item">B</a></li>
                  </ol>
                </div>
              </div>
              <div class="col-12 my-3 d-flex justify-content-center">
                <div>
                  <input type="button" value="Add to Watch List" id="item-add-submit"></input>
                </div>
              </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </header>