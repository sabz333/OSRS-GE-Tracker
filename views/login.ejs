<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Old School Runescape GE Tracker</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="<%- mainStyleSheet %>" />
  </head>
  <body>
    <header>
      <div class="container-fluid py-3 px-1 px-sm-2" id="mainHeader">
        <div class="row">
          <div class="col-4 d-flex align-items-center">
            <span class="material-symbols-rounded d-none"> menu </span>
              <a href="/" class="ps-3">
                <img id="logo" src="/assets/logo/logo_alt.svg" alt="OSRS GE Tracker Logo">
              </a>
          </div>
        <div class="col-4"></div>
        <div class="col-4 pe-3 d-flex flex-row-reverse">
          <div class="d-flex flex-column">
            <a class="d-flex flex-column align-items-center text-decoration-none" id="user" href="/">
              <span class="material-symbols-rounded" style="font-size: 36px;">
                home
                </span>
                <span style="font-size: 18px;">
                  HOME
                </span>
            </a>
          </div>
        </div>
      </div>
    </header>
    <main class="sign-in-main container-fluid px-1 px-sm-2 mt-0">
      <div class="container-md d-flex flex-column">
        <div class="sign-in-box container">
          <div class="container d-flex flex-column align-items-center">
            <img src="/assets/logo/logo_alt.svg" alt="OSRS GE Tracker Logo">
            <div class="container sign-in-text pt-4 pb-3">Sign in with Google</div>
            <a href="/auth/google" target="_self" class="google-icon-wrapper" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="75px" height="75px" class="google-icon"><path fill-rule="evenodd" d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10zm.044-5.213c2.445 0 4.267-1.551 4.556-3.781v-1.891h-4.519v1.89h2.602a2.893 2.893 0 0 1-2.724 1.93c-1.194 0-2.677-1.1-2.677-2.843 0-1.621 1.161-2.876 2.677-2.876.739 0 1.413.279 1.922.736l1.399-1.376a4.744 4.744 0 1 0-3.236 8.212z"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </main>

    <%- include('partials/footer.ejs'); %>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script type="module" src="./scripts/common.mjs"></script>
  </body>
</html>
