<%- include('partials/header.ejs'); %>

<main class="container my-5">
  <div id="itemTitle">
    <div class="d-flex align-items-center s-font" id="itemNavigation">
      <a class="text-uppercase fw-medium flat me-1" href="/">home</a>
      <span class="material-symbols-outlined l-font flat me-1">chevron_right</span>
      <div class="text-uppercase fw-medium"><%- itemDetails.name %></div>
    </div>
    <div class="d-flex align-items-center" id="itemHeader">
      <div class="m-0 pt-1" id="itemHeader-mainTitle"><%- itemDetails.name %></div>
      <img class="ms-2" src="https://services.runescape.com/m=itemdb_oldschool/obj_big.gif?id=<%-passedItemId%>" alt="Main Item Image">
    </div>
  </div>
  <div class="container">
    <div class="row gx-5">
      <div class="col-lg-8">
        <div class="container ps-0">
          <div class="priceInfo d-flex align-items-end">
            <div class="xl-font fw-small me-3" id="mainPrice"><%- itemCalcs.currentPrice %></div>
              <div class="percentChangePill <%- itemCalcs.change %> d-flex justify-content-end align-items-center me-2" id="mainPercentChange">
                <span class="material-symbols-rounded percentChangeArrow"><%- itemCalcs.arrow %></span>
                <span class="fw-medium">- %</span>
              </div>
              <div class="<%- itemCalcs.change %> fw-medium" id="mainPriceChange">- Today</div>
          </div>
          <div class="s-font mt-2 flat">Updated <%- updateTime %></div>
        </div>
        <div class="container mt-2 mb-3 ps-0">
          <span id="scaleSelectors">
            <button class="timeButton">
              <span class="selected" id="5m">1D</span>
            </button>
            <button class="timeButton">
              <span class="" id="1h">5D</span>
            </button>
            <button class="timeButton">
              <span class="" id="6h">1M</span>
            </button>
            <button class="timeButton">
              <span class="" id="24h">6M</span>
            </button>
            <button class="timeButton">
              <span class="" id="24h">1Y</span>
            </button>
          </span>
        </div>
        <div class="chart">
          <canvas id="mainPlot"></canvas>
          <div class="cursorInfo"></div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="row pb-4">
          <div class="col key-stats p-4">
            <div class="mainCategoryContainer mb-3">
              <a class="categoryPill">Potion</a>
            </div>
            <div class="priceStats d-flex py-2 justify-content-between align-items-center">
              <div class="d-flex align-items-center xs-font me-2 text-uppercase fw-medium">Opening Price</div>
              <div class="itemPriceStat m-font fw-medium"><%- itemCalcs.openPrice %></div>
            </div>
            <div class="priceStats d-flex py-2 justify-content-between align-items-center">
              <div class="d-flex align-items-center xs-font me-2 text-uppercase fw-medium">Day Range</div>
              <div class="itemPriceStat m-font fw-medium"><%- dayMinPrice %> - <%- dayMaxPrice %></div>
            </div>
            <div class="priceStats d-flex py-2 justify-content-between align-items-center">
              <div class="d-flex align-items-center xs-font me-2 text-uppercase fw-medium">Year Range</div>
              <div class="itemPriceStat m-font fw-medium"><%- yearMinPrice %> - <%- yearMaxPrice %></div>
            </div>
            <div class="priceStats d-flex py-2 justify-content-between align-items-center">
              <div class="d-flex align-items-center xs-font me-2 text-uppercase fw-medium">Avg Daily Volume</div>
              <div class="itemPriceStat m-font fw-medium"><%- averageVol.toLocaleString() %></div>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col key-stats">
            <div class="priceStats d-flex py-2 justify-content-between align-items-center">
              <div class="d-flex align-items-center xs-font me-2 text-uppercase fw-medium">Daily Trade Limit</div>
              <div class="itemPriceStat m-font fw-medium "><%- itemDetails.trade_limit.toLocaleString() %></div>
            </div>
            <div class="priceStats d-flex py-2 justify-content-between align-items-center">
              <div class="d-flex align-items-center xs-font me-2 text-uppercase fw-medium">High Alch</div>
              <div class="itemPriceStat m-font fw-medium "><%- itemDetails.high_alch %></div>
            </div>
            <div class="priceStats d-flex py-2 justify-content-between align-items-center">
              <div class="d-flex align-items-center xs-font me-2 text-uppercase fw-medium">Low Alch</div>
              <div class="itemPriceStat m-font fw-medium "><%-itemDetails.low_alch %></div>
            </div>
            <div class="priceStats d-flex py-2 justify-content-between align-items-center">
              <div class="d-flex align-items-center xs-font me-2 text-uppercase fw-medium">Description</div>
              <div class="itemPriceStat fw-medium s-font"><%-itemDetails.description %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>




<%- include('partials/footer.ejs'); -%>
  <script>const itemId = <%-passedItemId%>; </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
  <script type="module" src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script type="module" src="./scripts/common.mjs"></script>
  <script type="module" src="./scripts/item.mjs"></script>
  </body>
  
  </html>